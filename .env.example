# Required: Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Required for the admin bootstrap script only
AUTH_ADMIN_EMAIL=your-admin-email@example.com
ADMIN_INITIAL_PASSWORD=use-a-long-random-password-at-least-12-characters

# Required for image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Public production URL. Use the same HTTPS Render URL in Supabase Auth settings.
NEXT_PUBLIC_SITE_URL=https://your-service.onrender.com

# Application base URL (for internal redirects, API calls, etc.)
NEXT_PUBLIC_BASE_URL=https://your-service.onrender.com

# Optional payment integrations
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Optional: Admin API key for protected endpoints
ADMIN_API_KEY=replace_with_a_long_random_admin_api_key

# Optional email notifications
EMAIL_API_KEY=your_email_service_api_key
ADMIN_EMAIL=admin@example.com
FROM_EMAIL=no-reply@example.com
